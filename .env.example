# ==============================================================================
# قالب إعدادات الكنيسة الجديدة (.env.example)
# انسخ هذا الملف إلى .env ثم استبدل القيم ببيانات الكنيسة ومشروع Firebase الجديد
# Copy this file to .env and fill in the new church's own credentials.
# ==============================================================================

# --- 1. هوية الكنيسة والبراندينج (Church Identity & Branding) ---
VITE_TENANT_ID="new-church-client"
VITE_CHURCH_NAME="كنيسة ... (ضع اسم الكنيسة الجديدة هنا)"
VITE_CHURCH_SHORT_NAME="خدمة مدارس الأحد والتربية الكنسية"
VITE_SERVICE_TITLE="نظام إدارة الخدمة والافتقاد والحضور"
VITE_DIOCESE_NAME="إيبارشية ..."
VITE_CHURCH_PRIESTS=""
VITE_APP_LOGO_URL="/pwa-192x192.png"
VITE_PWA_ICON_URL="/pwa-192x192.png"
VITE_DEFAULT_OSRA_LOGO=""
VITE_MASTER_VIEW_NAME="كل الخدمة"
VITE_APK_DOWNLOAD_LINK=""

# --- 2. عزل قاعدة البيانات المحلية والمفاتيح (Browser DB & Storage Isolation) ---
# غيّر هذه الأسماء لكل كنيسة حتى لا تتداخل البيانات المحلية عند التجربة على نفس المتصفح
VITE_LOCAL_DB_NAME="ChurchMinistryDB_V1"
VITE_STORAGE_PREFIX="church_ministry_v1_"

# --- 3. إعدادات مشروع Firebase الجديد (Project Settings -> General -> Web App) ---
# تحذير: يحظر النظام تلقائياً أي تهيئة تحتوي على Placeholder أو بيانات كنيسة أخرى
VITE_FIREBASE_API_KEY="YOUR_NEW_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_NEW_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_NEW_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_NEW_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_NEW_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_NEW_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_RECAPTCHA_KEY=""

# --- 4. إعدادات Cloudinary الجديدة لرفع الصور وملفات المناهج (Upload Preset: Unsigned) ---
# في حال تركها فارغة، سيعمل النظام بحفظ الصور محلياً بصيغة Base64 مضغوطة تلقائياً
VITE_CLOUDINARY_CLOUD_NAME="YOUR_NEW_CLOUDINARY_CLOUD_NAME"
VITE_CLOUDINARY_UPLOAD_PRESET="YOUR_NEW_CLOUDINARY_UNSIGNED_PRESET"

# --- 5. أمان التشفير (Encryption Key) ---
# مفتاح تشفير البيانات داخل Firestore - أنشئ مفتاحاً فريداً خاصاً بهذه الكنيسة فقط
VITE_ENCRYPTION_SECRET="REPLACE_WITH_LONG_RANDOM_CHURCH_ENCRYPTION_SECRET"
